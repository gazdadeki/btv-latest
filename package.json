{
  "name": "btv",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "kill $(lsof -ti:3000,3001,3002) 2>/dev/null || true",
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@btv/backend",
    "dev:web": "turbo dev --filter=@btv/web",
    "dev:mobile": "turbo dev --filter=@btv/mobile",
    "dev:lan": "echo '⚠️  Unix-only (macOS/Linux). Windows: run dev:backend, dev:web, and mobile dev:lan separately.' && npm -w @btv/backend run dev & npm -w @btv/web run dev & npm -w @btv/mobile run dev:lan & wait",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
