# Database (external, separate machine)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=btv
# TypeORM schema sync (dangerous in shared/prod environments)
TYPEORM_SYNCHRONIZE=false

# JWT (defaults, can be overridden via AppConfig)
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Application
PORT=3000
NODE_ENV=development
API_VERSION=v1
# Bulk game websocket event mode: 'dual' or 'batch-only'
BULK_GAME_WS_MODE=dual

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase
# Path to Firebase service account JSON file (relative to project root or absolute path)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Email Configuration
# Provider options: 'console' (development logging) or 'mailtrap' (SMTP delivery)
EMAIL_SERVICE_PROVIDER=console

# Mailtrap SMTP Configuration (required when EMAIL_SERVICE_PROVIDER=mailtrap)
# Get credentials from: https://mailtrap.io/inboxes -> SMTP Settings
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password

# Email Sender Configuration
EMAIL_FROM_NAME=BTV
EMAIL_FROM_ADDRESS=noreply@btv.com

# Frontend URL (used for email links like password reset)
# For production: Use your dashboard URL (e.g., https://dashboard.thebaltazartv.app)
# This URL supports deep linking - on mobile it opens the app, on desktop it opens the web page
FRONTEND_URL=http://localhost:3000
