# ================================================================
# BaltazarTV Monorepo — Environment Variables Reference
# ================================================================
# This file documents ALL environment variables used across services.
# Each app also has its own .env.example with only its variables.
#
# For local development, copy each app's .env.example into the
# respective app directory as .env (backend) or .env.local (Next.js).
#
# For production / Docker, inject these via docker-compose env_file,
# Kubernetes secrets, or your CI/CD platform.
# ================================================================

# ─── Backend (apps/backend) ────────────────────────────────────
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=btv4

# JWT
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS (comma-separated origins; omit for reflect-origin in development)
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase (for push notifications)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Admin UI (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ─── Public UI (apps/public-ui) ────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3000
