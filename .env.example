# ================================================================
# BaltazarTV Monorepo — Environment Variables Reference
# ================================================================
# This file documents ALL environment variables used across services.
# Each app also has its own .env.example with only its variables.
#
# For local development, copy each app's .env.example into the
# respective app directory as .env (backend) or .env.local (Next.js).
#
# For production / Docker, inject these via docker-compose env_file,
# Kubernetes secrets, or your CI/CD platform.
# ================================================================

# ─── Backend (apps/backend) ────────────────────────────────────
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=btv4

# JWT (single secret signs both tokens; must NOT be a known default — the app rejects it at boot)
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# CORS (comma-separated bare origins; REQUIRED at boot — no reflect-origin fallback)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — provider: 'console' (dev logging) or 'mailtrap' (SMTP delivery)
EMAIL_SERVICE_PROVIDER=console
# Mailtrap SMTP (required when EMAIL_SERVICE_PROVIDER=mailtrap)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
EMAIL_FROM_NAME=BTV
EMAIL_FROM_ADDRESS=noreply@btv.com
# Used for links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000

# Firebase (for push notifications)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Admin UI (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ─── Public UI (apps/public-ui) ────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3000
