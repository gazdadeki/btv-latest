# BaltazarTV Production Nginx Reverse Proxy
#
# Three standalone Node processes, one subdomain each:
#   - Backend  (NestJS)   127.0.0.1:3000  → api.<domain>   (REST API + Socket.IO + deep-link .well-known)
#   - Web      (Next.js)  127.0.0.1:3001  → admin.<domain>   (admin dashboard)
#   - Mobile   (Next.js)  127.0.0.1:3002  → app.<domain>   (player PWA)
#
# Replace <domain> with your real domain and fix the TLS cert paths (certbot
# usually writes /etc/letsencrypt/live/<name>/fullchain.pem + privkey.pem).
#
# IMPORTANT — IP integrity for rate limiting / audit logs: every proxy block sets
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# The backend runs `app.set('trust proxy', 1)`, so it reads exactly the IP nginx
# appends here and discards client-supplied XFF. If you ever put a load balancer
# in front of nginx, bump trust proxy to 2 (see pre-prod checklist Fix 6).
#
# The mobile PWA REQUIRES HTTPS on its own origin to install — that is the whole
# point of the dedicated app.<domain> block below.

upstream backend { server 127.0.0.1:3000; }
upstream web     { server 127.0.0.1:3001; }
upstream app     { server 127.0.0.1:3002; }

# ---- HTTP → HTTPS redirect for all three subdomains ----
server {
    listen 80;
    server_name api.<domain> admin.<domain> app.<domain>;
    return 301 https://$host$request_uri;
}

# ============================ api.<domain> → backend ============================
server {
    listen 443 ssl http2;
    server_name api.<domain>;

    ssl_certificate     /etc/letsencrypt/live/api.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.<domain>/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 50m;  # avatar / file uploads

    # Socket.IO (WebSocket upgrade) — clients connect here for real-time events.
    location /socket.io/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # REST API (/api/v1/...), Stripe webhook, static avatars, everything else.
    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ========================= admin.<domain> → admin (Next.js) =========================
server {
    listen 443 ssl http2;
    server_name admin.<domain>;

    ssl_certificate     /etc/letsencrypt/live/admin.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.<domain>/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # X-Frame-Options / CSP frame-ancestors are also set by the Next app itself
    # (next.config.ts headers()) — these nginx headers are belt-and-suspenders.

    client_max_body_size 50m;

    # The Next server proxies its own /api/* and /avatars/* to the backend via
    # NEXT_PUBLIC_API_URL, so nginx just forwards everything to the app port.
    location / {
        proxy_pass http://web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ======================= app.<domain> → mobile PWA (Next.js) =======================
server {
    listen 443 ssl http2;
    server_name app.<domain>;

    ssl_certificate     /etc/letsencrypt/live/app.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.<domain>/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 50m;

    # Deep-link association files must be served from the app's OWN origin, so
    # proxy them to the backend (which serves /.well-known/assetlinks.json and
    # /.well-known/apple-app-site-association with the correct content-type).
    location /.well-known/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The PWA itself: manifest.json, sw.js, workbox-*, swe-worker-*, /icons/*,
    # apple-touch-icon.png, /install, /offline, and all app routes. The Next
    # server proxies its own /api/* and /avatars/* to the backend, so no extra
    # location blocks are needed.
    location / {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
