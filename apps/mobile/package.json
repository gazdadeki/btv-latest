{
  "name": "@btv/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002 --hostname 0.0.0.0",
    "dev:lan": "node -e \"const n=require('os').networkInterfaces();const ip=Object.values(n).flat().find(i=>i.family==='IPv4'&&!i.internal)?.address||'0.0.0.0';console.log('\\n  LAN: http://'+ip+':3002\\n')\" && next dev -p 3002 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@btv/types": "*",
    "@ducanh2912/next-pwa": "^10",
    "@stripe/react-stripe-js": "^2",
    "@stripe/stripe-js": "^4",
    "@tanstack/react-query": "^5",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "firebase": "^12.11.0",
    "lucide-react": "^0.474",
    "next": "^15",
    "protobufjs": "7.5.9",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.6.0",
    "react-markdown": "^9",
    "socket.io-client": "^4.8.3",
    "sonner": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@btv/tsconfig": "*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
